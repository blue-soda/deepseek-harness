# Android embedded Host runtime profile.
#
# This profile preserves the DSH Web Host/API/event stream, the Android mobile
# tool surface, DeepSeek/Pi-AI model paths, and DSH's own in-process subagent
# providers. It prunes providers and native prebuilds that the Android app
# cannot execute or does not expose.

# Provider SDKs outside the current Android target path. Keep @earendil-works/pi-ai,
# openai, anthropic, and dsh-llm-deepseek because the mobile app uses these
# routes for DeepSeek/OpenAI/Anthropic-compatible models.
PRUNE_PNPM_ENTRY_PATTERNS="
@mistralai+mistralai@*
@google+genai@*
google-auth-library@*
gaxios@*
google-logging-utils@*
@aws-*
@aws+*
@smithy+*
"

# Desktop/native packages disabled by the Android profile patch. DSH-native
# subagent packages are intentionally not listed here.
PRUNE_PNPM_ENTRY_PATTERNS="$PRUNE_PNPM_ENTRY_PATTERNS
@deepseek-ai+dsh-attachment-local@*
@deepseek-ai+dsh-host-directory-picker-native@*
@deepseek-ai+dsh-host-directory-picker-browse@*
@deepseek-ai+dsh-host-directory-picker-auto@*
@deepseek-ai+dsh-pwsh-sandbox@*
@deepseek-ai+dsh-tool-pwsh@*
@deepseek-ai+dsh-subprocess-local@*
@deepseek-ai+dsh-sandbox-local@*
@deepseek-ai+dsh-bash-sandbox@*
"

# Native prebuilds for non-Android platforms.
PRUNE_PNPM_ENTRY_PATTERNS="$PRUNE_PNPM_ENTRY_PATTERNS
@img+sharp-win32-*
@img+sharp-darwin-*
@img+sharp-linux-*
@vscode+ripgrep-win32-*
@vscode+ripgrep-darwin-*
@vscode+ripgrep-linux-*
@koromix+koffi-win32-*
@koromix+koffi-darwin-*
@koromix+koffi-linux-*
@reflink+reflink-win32-*
@reflink+reflink-darwin-*
@reflink+reflink-linux-*
node-addon-require-builtin-win32-*
node-addon-require-builtin-darwin-*
node-addon-require-builtin-linux-*
@anthropic-ai+claude-agent-sdk-win32-*
@anthropic-ai+claude-agent-sdk-darwin-*
@anthropic-ai+claude-agent-sdk-linux-*
node-pty@*
koffi@*
sharp@*
"

# External agent-framework adapters are not useful inside Android. DSH's own
# subagent registry/tools/providers remain available.
PRUNE_PNPM_ENTRY_PATTERNS="$PRUNE_PNPM_ENTRY_PATTERNS
@deepseek-ai+dsh-subagent-codex@*
@deepseek-ai+dsh-subagent-claude-code@*
@openai+codex@*
@anthropic-ai+claude-agent-sdk@*
"

# File-level cleanup. Keep build/src because several runtime packages execute
# JS from dist folders named src.
PRUNE_FILE_GLOBS="
*.d.ts
*.d.mts
*.d.cts
*.ts.map
*.js.map
*.mjs.map
*.cjs.map
*.tsbuildinfo
"

PRUNE_DIR_NAMES="
test
tests
__tests__
fixtures
docs
doc
examples
example
benchmark
benchmarks
.github
.vscode
"

PRUNE_NODE_PTY_PREBUILD_DIRS="
darwin-arm64
darwin-x64
linux-arm64
linux-x64
win32-arm64
win32-x64
"

PRUNE_REMOVE_BROKEN_SYMLINKS=false
