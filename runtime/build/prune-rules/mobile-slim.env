# Default runtime-pruning profile for the Android embedded DSH artifact.
#
# This file is sourced by prune-dsh-runtime.sh. Keep the values newline-free:
# each list is a shell word list matched against node_modules/.pnpm entry names.

# Remove LLM providers that are outside the current mobile target set.
PRUNE_PNPM_ENTRY_PATTERNS="
@mistralai+mistralai@*
@google+genai@*
@earendil-works+pi-ai@*
@deepseek-ai+dsh-llm-pi-ai@*
@aws-*
@aws+*
@smithy+*
google-auth-library@*
gaxios@*
google-logging-utils@*
"

# Remove web/search/browser-facing packages not needed by embedded Android.
PRUNE_PNPM_ENTRY_PATTERNS="$PRUNE_PNPM_ENTRY_PATTERNS
@algolia+*
@deepseek-ai+dsh-web-*
@deepseek-ai+dsh-client-ui-*
react@*
react-dom@*
@types+react@*
zustand@*
use-sync-external-store@*
csstype@*
@tanstack+react-virtual@*
@mixmark-io+domino@*
jsdom@*
@asamuzakjp+*
"

# Remove native packages for platforms that cannot run in Android.
PRUNE_PNPM_ENTRY_PATTERNS="$PRUNE_PNPM_ENTRY_PATTERNS
@img+sharp-win32-*
@img+sharp-darwin-*
@img+sharp-linux-*
@vscode+ripgrep-win32-*
@vscode+ripgrep-darwin-*
@vscode+ripgrep-linux-*
@koromix+koffi-win32-*
@koromix+koffi-darwin-*
@koromix+koffi-linux-*
@reflink+reflink-win32-*
@reflink+reflink-darwin-*
@reflink+reflink-linux-*
node-addon-require-builtin-win32-*
node-addon-require-builtin-darwin-*
node-addon-require-builtin-linux-*
@anthropic-ai+claude-agent-sdk-win32-*
@anthropic-ai+claude-agent-sdk-darwin-*
@anthropic-ai+claude-agent-sdk-linux-*
"

# File-level cleanup. Do not include src directories globally:
# some packages, including OpenTelemetry, use build/src as runtime JS.
PRUNE_FILE_GLOBS="
*.d.ts
*.d.mts
*.d.cts
*.ts.map
*.js.map
*.mjs.map
*.cjs.map
*.tsbuildinfo
"

PRUNE_DIR_NAMES="
test
tests
__tests__
fixtures
docs
doc
examples
example
benchmark
benchmarks
.github
.vscode
"

# Android does not load these node-pty prebuild names. If android-* appears in
# the future, this profile leaves it in place.
PRUNE_NODE_PTY_PREBUILD_DIRS="
darwin-arm64
darwin-x64
linux-arm64
linux-x64
win32-arm64
win32-x64
"

# pnpm deploy may keep workspace dependency links that look unusual from a
# plain filesystem-pruning point of view. Removing "broken" symlinks here can
# break package resolution before artifact normalization has a chance to run.
PRUNE_REMOVE_BROKEN_SYMLINKS=false
