# Full runtime profile for Android embedded DSH artifacts.
#
# This profile intentionally does not prune packages or files. The artifact
# builder still normalizes runtime symlinks and verifies `dsh --version`.

PRUNE_PNPM_ENTRY_PATTERNS=""
PRUNE_FILE_GLOBS=""
PRUNE_DIR_NAMES=""
PRUNE_NODE_PTY_PREBUILD_DIRS=""
PRUNE_REMOVE_BROKEN_SYMLINKS=false
