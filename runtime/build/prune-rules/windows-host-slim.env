# Windows embedded Host runtime profile.
#
# This profile preserves the DSH Web Host/API/event stream and Windows-capable
# local tools while pruning native prebuilds for non-Windows targets.

PRUNE_PNPM_ENTRY_PATTERNS="
@img+sharp-darwin-*
@img+sharp-linux-*
@vscode+ripgrep-darwin-*
@vscode+ripgrep-linux-*
@koromix+koffi-darwin-*
@koromix+koffi-linux-*
@reflink+reflink-darwin-*
@reflink+reflink-linux-*
node-addon-require-builtin-darwin-*
node-addon-require-builtin-linux-*
@anthropic-ai+claude-agent-sdk-darwin-*
@anthropic-ai+claude-agent-sdk-linux-*
"

PRUNE_FILE_GLOBS="
*.d.ts
*.d.mts
*.d.cts
*.ts.map
*.js.map
*.mjs.map
*.cjs.map
*.tsbuildinfo
"

PRUNE_DIR_NAMES="
test
tests
__tests__
fixtures
docs
examples
example
benchmark
benchmarks
.github
.vscode
"

PRUNE_NODE_PTY_PREBUILD_DIRS="
darwin-arm64
darwin-x64
linux-arm64
linux-x64
"

PRUNE_REMOVE_BROKEN_SYMLINKS=false
